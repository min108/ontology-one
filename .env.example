# Copy to .env and replace both values with independent random secrets.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
ONTOLOGY_PORT=8765
ONTOLOGY_API_WORKERS=4
ONTOLOGY_DB_POOL_SIZE=16
ONTOLOGY_TRUSTED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
# Set 1 behind a trusted HTTPS reverse proxy; 0 is for localhost trial only.
ONTOLOGY_COOKIE_SECURE=0
# MCP server: explicit public/intranet host names; wildcard ports only for local development.
ONTOLOGY_MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
ONTOLOGY_MCP_MAX_CONCURRENT=4
# Skill authoring uses a fresh /dev/shm tmpfs home for every official Harness run.
ONTOLOGY_HARNESS_MAX_CONCURRENT=2
# Host-only development; Docker deployments use ops/compose.skills.yml.
# ONTOLOGY_SKILL_RUNNER_SOCKET=/tmp/ontology-skill-runner.sock
# Optional source adapter overlay. Actual secrets stay in a protected file outside the repository.
# ONTOLOGY_SOURCE_CREDENTIALS_PATH=/absolute/private/source-credentials.json
