{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": false,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "node_modules/.cache/legacy-types",
    "paths": {
      "@legacy/*": [
        "./src/legacy/*"
      ]
    }
  },
  "include": [
    "src/legacy"
  ],
  "exclude": []
}
