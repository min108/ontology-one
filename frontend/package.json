{
  "name": "ontology-one",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run typecheck:legacy && vite --host 0.0.0.0",
    "build": "npm run typecheck && npm run check:legacy-css && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint eslint.config.js src --no-error-on-unmatched-pattern --no-warn-ignored",
    "format:check": "prettier --check eslint.config.js .prettierrc.json .stylelintrc.json \"src/{app,design,ui,features,api,state,i18n}/**/*.{ts,tsx,css,json}\" --no-error-on-unmatched-pattern",
    "lint:styles": "stylelint \"src/{app,design,ui,features,api,state,i18n}/**/*.css\" --allow-empty-input",
    "test": "vitest",
    "typecheck:design": "npm run typecheck:legacy && tsc --project tsconfig.design.json",
    "typecheck:legacy": "tsc --project tsconfig.legacy.json",
    "typecheck": "npm run typecheck:legacy && tsc --project tsconfig.json",
    "check:legacy-css": "node build/check-legacy-css.mjs",
    "test:isolation": "npm run typecheck:legacy && node --test build/legacy-css.test.mjs build/type-boundary.test.mjs"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "lucide-react": "0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "recharts": "2.15.4",
    "antd": "6.7.0",
    "@ant-design/x": "2.10.0",
    "@tanstack/react-query": "5.107.1",
    "zustand": "5.1.0",
    "@antv/g6": "5.1.1",
    "echarts": "6.1.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "rehype-sanitize": "6.0.0",
    "diff": "9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "6.4.5",
    "vitest": "5.1.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.12",
    "@playwright/test": "1.65.1",
    "openapi-typescript": "7.13.0",
    "postcss-prefix-selector": "2.2.1",
    "jsdom": "31.0.1",
    "@types/node": "22.19.15",
    "@axe-core/playwright": "4.14.0"
  }
}
