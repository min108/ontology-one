{
  "name": "ontology-one",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint eslint.config.js src --no-error-on-unmatched-pattern --no-warn-ignored",
    "format:check": "prettier --check eslint.config.js .prettierrc.json .stylelintrc.json \"src/{app,design,ui,features,api,state,i18n}/**/*.{ts,tsx,css,json}\" --no-error-on-unmatched-pattern",
    "lint:styles": "stylelint \"src/{app,design,ui,features,api,state,i18n}/**/*.css\" --allow-empty-input"
  },
  "dependencies": {
    "@xyflow/react": "^12.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "8.72.2",
    "vite": "^6.3.0"
  }
}
