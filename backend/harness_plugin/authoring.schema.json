{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 2000,
      "description": "Explain proposed changes in the user's language. For missing business definitions or unauthorized requests, list the unresolved questions or boundary and submit empty changes, delete_paths and manifest_patch."
    },
    "changes": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "content": {
            "type": "string",
            "description": "Full UTF-8 contents of this changed file only, at most 256 KiB. Preserve the SKILL.md package name and valid YAML frontmatter."
          }
        },
        "required": [
          "path",
          "content"
        ],
        "additionalProperties": false
      }
    },
    "delete_paths": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "manifest_patch": {
      "type": "object",
      "description": "Optional portable fields only. Omitted fields remain unchanged. Never modify dependencies, tool_dependencies or publication/review state.",
      "properties": {
        "applicability": {
          "type": "string",
          "maxLength": 4000
        },
        "inputs": {
          "type": "object",
          "description": "A bounded reference-free JSON Schema, maximum schema depth 8 and 32 KiB. Every nested schema must use this same profile and one explicit string type. Object properties and array items are schemas. required must name declared properties. additionalProperties is boolean. Arrays require items. No $ref, $defs, $schema, oneOf, anyOf, allOf, format, pattern or type arrays.",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "object",
                "array",
                "string",
                "integer",
                "number",
                "boolean",
                "null"
              ]
            },
            "properties": {
              "type": "object",
              "maxProperties": 100,
              "additionalProperties": {
                "type": "object",
                "description": "A child schema following the same bounded profile; every child requires type."
              }
            },
            "required": {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "additionalProperties": {
              "type": "boolean"
            },
            "items": {
              "type": "object",
              "description": "Required for an array; child schema follows the same bounded profile and requires type."
            },
            "enum": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100
            },
            "const": {},
            "minLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "maxLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "minItems": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "maxItems": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            },
            "title": {
              "type": "string",
              "maxLength": 2000
            },
            "description": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        "outputs": {
          "type": "object",
          "description": "A bounded reference-free JSON Schema, maximum schema depth 8 and 32 KiB. Every nested schema must use this same profile and one explicit string type. Object properties and array items are schemas. required must name declared properties. additionalProperties is boolean. Arrays require items. No $ref, $defs, $schema, oneOf, anyOf, allOf, format, pattern or type arrays.",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "object",
                "array",
                "string",
                "integer",
                "number",
                "boolean",
                "null"
              ]
            },
            "properties": {
              "type": "object",
              "maxProperties": 100,
              "additionalProperties": {
                "type": "object",
                "description": "A child schema following the same bounded profile; every child requires type."
              }
            },
            "required": {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "additionalProperties": {
              "type": "boolean"
            },
            "items": {
              "type": "object",
              "description": "Required for an array; child schema follows the same bounded profile and requires type."
            },
            "enum": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100
            },
            "const": {},
            "minLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "maxLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "minItems": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "maxItems": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            },
            "title": {
              "type": "string",
              "maxLength": 2000
            },
            "description": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        "steps": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "instruction": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "title",
              "instruction"
            ],
            "additionalProperties": false
          }
        },
        "entrypoint": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 240,
              "pattern": "^scripts/.+\\.py$"
            },
            {
              "type": "null"
            }
          ],
          "description": "A retained scripts/*.py file, or null. Python scripts use only the standard library, read one JSON value from stdin and write one JSON value to stdout; no network, host filesystem, environment or external packages."
        },
        "test_cases": {
          "type": "array",
          "maxItems": 10,
          "description": "Synthetic examples only; unique names. Inputs and expected outputs must match the corresponding JSON Schemas. Do not fabricate business thresholds, units, object identifiers or join keys.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "input": {
                "description": "One finite JSON value, maximum 64 KiB."
              },
              "expected_output": {
                "description": "Expected finite JSON value, maximum 64 KiB."
              }
            },
            "required": [
              "name",
              "input",
              "expected_output"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "summary",
    "changes",
    "delete_paths",
    "manifest_patch"
  ],
  "additionalProperties": false
}
